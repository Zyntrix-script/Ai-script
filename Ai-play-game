--========================================================
-- MOBILE DRAG
--========================================================

Main.InputBegan:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.Touch
        or input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            Dragging = true

            DragStart =
                input.Position

            StartPosition =
                Main.Position

        end

    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if not Dragging then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.Touch
        or input.UserInputType ==
            Enum.UserInputType.MouseMovement then

            local delta =
                input.Position -
                DragStart

            Main.Position =
                UDim2.new(
                    StartPosition.X.Scale,
                    StartPosition.X.Offset +
                        delta.X,

                    StartPosition.Y.Scale,
                    StartPosition.Y.Offset +
                        delta.Y
                )

        end

    end
)

UserInputService.InputEnded:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.Touch
        or input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            Dragging = false

        end

    end
)

--========================================================
-- TARGET FOLLOW UPDATE
--========================================================
-- Nhân vật có thể di chuyển trong lúc đang xem đường.
-- Không điều khiển Humanoid.

local lastRootPosition = nil
local lastRebuild = 0

RunService.Heartbeat:Connect(
    function()

        if not Enabled then
            return
        end

        if not TargetPosition then
            return
        end

        if not Root then
            UpdateCharacter()
            return
        end

        -- Nếu người chơi tự di chuyển,
        -- cập nhật đường từ vị trí hiện tại.
        local current =
            Root.Position

        if lastRootPosition then

            local moved =
                (
                    current -
                    lastRootPosition
                ).Magnitude

            if moved > 4
            and os.clock() -
                lastRebuild > 0.25 then

                lastRebuild =
                    os.clock()

                PathVersion += 1

                local version =
                    PathVersion

                CurrentPath = {}

                task.spawn(function()

                    local newPath =
                        CalculatePath(
                            TargetPosition
                        )

                    if not Enabled then
                        return
                    end

                    if version ~=
                        PathVersion then

                        return
                    end

                    CurrentPath =
                        newPath

                    DrawPath()

                end)

            end

        end

        lastRootPosition =
            current

        -- Target marker luôn giữ ở vị trí click
        -- và không ảnh hưởng collision.

        if TargetMarker then

            local billboard =
                TargetMarker:FindFirstChild(
                    "TargetImage"
                )

            if billboard then

                local image =
                    billboard:FindFirstChild(
                        "ImageLabel"
                    )

                if image then

                    local pulse =
                        (
                            math.sin(
                                os.clock() * 3
                            ) + 1
                        ) / 2

                    image.ImageTransparency =
                        0.05 +
                        pulse * 0.25

                    billboard.StudsOffset =
                        Vector3.new(
                            0,
                            0.1 +
                            pulse * 0.2,
                            0
                        )

                end

            end

        end

    end
)

