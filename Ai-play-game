-- 6. TELEPORT RANDOM DOWNED PLAYER & RETURN
-- =============================================================================
local function GetLivingRoot(character)
    if not character or not character.Parent then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    return root
end

local function IsDowned(player)
    if not player or player == LocalPlayer then return false end
    local character = player.Character
    if not character or not character.Parent then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if character:GetAttribute("Downed") == true or (hum and hum.Health <= 0) then
        return GetLivingRoot(character) ~= nil
    end
    return false
end

local function GetRandomDownedPlayer()
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if IsDowned(player) then
            local root = GetLivingRoot(player.Character)
            if root then table.insert(candidates, player) end
        end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

local teleButtonLabel, teleButton, teleButtonStroke

local function TeleDownOrReturn()
    if closed then return end
    local char = LocalPlayer.Character
    local root = GetLivingRoot(char)
    if not root then
        Notify("Zyntrix V16", "Không tìm thấy nhân vật!")
        return
    end

    if teleDownActive and savedCFrame then
        local ok = pcall(function() char:PivotTo(savedCFrame) end)
        if ok then
            savedCFrame = nil
            teleDownActive = false
            teleButtonLabel.Text = "TELE DOWN: ĐI / VỀ"
            teleButton.BackgroundColor3 = GLASS
            teleButtonStroke.Color = CYAN
            Notify("Zyntrix V16", "Đã quay về vị trí ban đầu.")
        else
            Notify("Zyntrix V16", "Quay về thất bại!")
        end
        return
    end

    local target = GetRandomDownedPlayer()
    if not target then
        Notify("Zyntrix V16", "Không tìm thấy người chơi nào đang Down.")
        return
    end

    local targetRoot = GetLivingRoot(target.Character)
    if not targetRoot then
        Notify("Zyntrix V16", "Mục tiêu không hợp lệ.")
        return
    end

    savedCFrame = root.CFrame
    local destination = targetRoot.CFrame + Vector3.new(0, 3, 0)
    local ok = pcall(function() char:PivotTo(destination) end)

    if ok then
        teleDownActive = true
        teleButtonLabel.Text = "QUAY VỀ VỊ TRÍ CŨ"
        teleButton.BackgroundColor3 = Col3RGB(10, 50, 90)
        teleButtonStroke.Color = GREEN
        Notify("Zyntrix V16", "Đã đến chỗ người Down: " .. target.Name)
    else
        Notify("Zyntrix V16", "Teleport thất bại.")
    end
end

