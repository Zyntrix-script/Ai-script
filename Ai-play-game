local ledTime = 0

RunService.RenderStepped:Connect(
    function(dt)

        ledTime += dt * 2

        local pulse =
            (
                math.sin(ledTime) + 1
            ) / 2

        Stroke.Transparency =
            0.03 +
            pulse * 0.22

        if Marker then

            local gui =
                Marker:FindFirstChild(
                    "TargetImage"
                )

            if gui then

                gui.StudsOffset =
                    Vector3.new(
                        0,
                        0.1 +
                        pulse * 0.25,
                        0
                    )

                local image =
                    gui:FindFirstChild(
                        "ImageLabel"
                    )

                if image then

                    image.ImageTransparency =
                        0.05 +
                        pulse * 0.25

                end

            end

        end

    end
)

