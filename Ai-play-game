local function getESPContainer()
    local success, result = pcall(function()
        local container = CoreGui:FindFirstChild("Zyntrix_ESP_Container")
        if not container then
            container = InstNew("Folder")
            container.Name = "Zyntrix_ESP_Container"
            container.Parent = CoreGui
        end
        return container
    end)
    if success and result then return result end
    local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)  
    if pg then  
        local container = pg:FindFirstChild("Zyntrix_ESP_Container")  
        if not container then  
            container = InstNew("Folder")  
            container.Name = "Zyntrix_ESP_Container"  
            container.Parent = pg  
        end  
        return container  
    end  
    return nil
end

local espContainer = getESPContainer()

local function cleanupESP(object)
    if not object then return end
    local uniqueId = object:GetDebugId()
    if activeESPElements[uniqueId] then
        for _, element in ipairs(activeESPElements[uniqueId]) do
            if element and element.Parent then element:Destroy() end
        end
        activeESPElements[uniqueId] = nil
    end
    if espContainer then
        for _, child in ipairs(espContainer:GetChildren()) do
            if string.find(child.Name, tostring(uniqueId)) then child:Destroy() end
        end
    end
end

local function registerESPElement(object, element)
    if not object then return end
    local uniqueId = object:GetDebugId()
    if not activeESPElements[uniqueId] then activeESPElements[uniqueId] = {} end
    table.insert(activeESPElements[uniqueId], element)
end

-- ESP Vé / Tickets
local function applyTicketESP(object)
    if not states.espTickets or not object or not object.Parent then return end
    if not object:IsA("BasePart") and not object:IsA("Model") then return end
    
    local uniqueId = object:GetDebugId()
    if activeESPElements[uniqueId] then return end

    local targetPart = object  
    if object:IsA("Model") then  
        targetPart = object:FindFirstChildWhichIsA("BasePart") or object.PrimaryPart  
        if not targetPart then return end  
    end  

    if not espContainer then return end

    local highlight = InstNew("Highlight")  
    highlight.Name = "TicketESP_Highlight_" .. uniqueId  
    highlight.Adornee = object  
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop  
    highlight.FillColor = Col3RGB(0, 150, 255)  
    highlight.OutlineColor = ICE  
    highlight.FillTransparency = 0.6  
    highlight.OutlineTransparency = 0  
    highlight.Parent = espContainer  
    registerESPElement(object, highlight)

    local bgui = InstNew("BillboardGui")  
    bgui.Name = "TicketESP_Billboard_" .. uniqueId  
    bgui.Adornee = targetPart  
    bgui.Size = UDim2.new(0, 100, 0, 25)  
    bgui.StudsOffset = Vector3.new(0, 2, 0)  
    bgui.AlwaysOnTop = true  
    bgui.Parent = espContainer  
    registerESPElement(object, bgui)

    local textLabel = InstNew("TextLabel")  
    textLabel.BackgroundTransparency = 1  
    textLabel.Size = UDim2.new(1, 0, 1, 0)  
    textLabel.TextColor3 = Col3RGB(0, 150, 255)  
    textLabel.TextStrokeTransparency = 0  
    textLabel.TextSize = 12  
    textLabel.Font = Enum.Font.SourceSansBold  
    textLabel.Text = "VÉ / BUBBLES"  
    textLabel.Parent = bgui  
end

