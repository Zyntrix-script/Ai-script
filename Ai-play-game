-- Mobile Drag Handler (Chống kẹt cảm ứng & tránh nhầm click)
local function MakeDraggable(object, handle)
    local dragging = false
    local dragInput
    local startPointer
    local startPosition
    local moved = false
    local suppressClick = false

    Connect(handle.InputBegan, function(input)  
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end  
        dragging = true  
        moved = false  
        dragInput = input  
        startPointer = input.Position  
        startPosition = object.Position  
    end)  

    Connect(UserInputService.InputChanged, function(input)  
        if not dragging or not dragInput then return end  
        local matchingTouch = dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput  
        local matchingMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement  
        if not matchingTouch and not matchingMouse then return end  

        local delta = input.Position - startPointer  
        if abs(delta.X) > 3 or abs(delta.Y) > 3 then moved = true end  

        object.Position = UDim2.new(  
            startPosition.X.Scale,  
            startPosition.X.Offset + delta.X,  
            startPosition.Y.Scale,  
            startPosition.Y.Offset + delta.Y  
        )  
    end)  

    Connect(UserInputService.InputEnded, function(input)  
        if input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then  
            dragging = false  
            dragInput = nil  
            if moved then  
                suppressClick = true  
                task.defer(function() suppressClick = false end)  
            end  
        end  
    end)  

    return function() return suppressClick end
end

