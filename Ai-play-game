-- Speed Loop
RunService.RenderStepped:Connect(function()
    if speedEnabled then
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.MoveDirection.Magnitude > 0 then
                hrp.Velocity = Vector3.new(
                    hum.MoveDirection.X * speed * 10,
                    hrp.Velocity.Y,
                    hum.MoveDirection.Z * speed * 10
                )
            end
        end
    end
end)

-- Infinite Slide Core Loop
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.RenderStepped:Connect(function()
    if not InfiniteSlideEnabled then
        return
    end

    if not CurrentCharacter or not RootPart or not Humanoid then
        return
    end

    if Humanoid.Health <= 0 then
        return
    end

    pcall(function()
        local currentVel = RootPart.AssemblyLinearVelocity
        local horizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)

        if horizontalVel.Magnitude > 5 then
            local currentCFrame = RootPart.CFrame
            raycastParams.FilterDescendantsInstances = {CurrentCharacter}

            local raycastResult = Workspace:Raycast(
                currentCFrame.Position,
                Vector3.new(0, -4, 0),
                raycastParams
            )

            if raycastResult then
                local targetY = raycastResult.Position.Y + 3 + CONFIG.HoverOffset
                RootPart.CFrame = CFrame.new(
                    currentCFrame.X,
                    targetY,
                    currentCFrame.Z
                ) * currentCFrame.Rotation
            end

            RootPart.AssemblyLinearVelocity = Vector3.new(
                horizontalVel.X,
                currentVel.Y,
                horizontalVel.Z
            )
        end
    end)
end)
