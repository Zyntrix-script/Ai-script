--========================================================
-- TARGET MARKER
--========================================================

local function RemoveMarker()

    if TargetMarker then
        TargetMarker:Destroy()
        TargetMarker = nil
    end

end

local function CreateMarker(position,normal)

    RemoveMarker()

    local part = Instance.new("Part")

    part.Name = "TargetMarker"

    part.Size =
        Vector3.new(
            CONFIG.MarkerSize,
            0.08,
            CONFIG.MarkerSize
        )

    part.Anchored = true

    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false

    part.Transparency = 1

    part.CFrame =
        CFrame.lookAt(
            position + normal * 0.05,
            position + normal
        )

    part.Parent = VisualFolder

    local billboard =
        Instance.new("BillboardGui")

    billboard.Name = "TargetImage"

    billboard.Size =
        UDim2.fromOffset(55,55)

    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0

    billboard.Parent = part

    local image =
        Instance.new("ImageLabel")

    image.BackgroundTransparency = 1

    image.Size =
        UDim2.fromScale(1,1)

    image.Image =
        "rbxassetid://71165623455163"

    image.ImageTransparency = 0.05

    image.Parent = billboard

    TargetMarker = part

end

--========================================================
-- RAY POOL
--========================================================

local function GetRay(index)

    if RayPool[index] then
        return RayPool[index]
    end

    local part = Instance.new("Part")

    part.Name = "GuideRay_" .. index

    part.Anchored = true

    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false

    part.Material = Enum.Material.Neon

    part.Color = CONFIG.Green

    part.Transparency =
        CONFIG.RayTransparency

    part.Size =
        Vector3.new(
            CONFIG.RayThickness,
            CONFIG.RayThickness,
            1
        )

    part.Parent = VisualFolder

    RayPool[index] = part

    return part

end

--========================================================
-- DRAW ONE RAY
--========================================================

local function DrawRay(index,a,b)

    if not a or not b then
        return
    end

    local ray = GetRay(index)

    local distance =
        (b-a).Magnitude

    if distance <= 0.05 then

        ray.Transparency = 1

        return
    end

    ray.Transparency =
        CONFIG.RayTransparency

    ray.Size =
        Vector3.new(
            CONFIG.RayThickness,
            CONFIG.RayThickness,
            distance
        )

    ray.CFrame =
        CFrame.lookAt(
            (a+b)/2,
            b
        )

end

--========================================================
-- HIDE RAYS
--========================================================

local function HideRays()

    for _,ray in pairs(RayPool) do

        ray.Transparency = 1

    end

end

--========================================================
-- CLEAR PATH
--========================================================

local function ClearPath()

    CurrentPath = {}

    HideRays()

end

--========================================================
-- RAYCAST PARAMS
--========================================================

local RayParams =
    RaycastParams.new()

RayParams.FilterType =
    Enum.RaycastFilterType.Exclude

local function UpdateRayFilter()

    local filter = {
        VisualFolder
    }

    if Character then
        table.insert(
            filter,
            Character
        )
    end

    RayParams.FilterDescendantsInstances =
        filter

end

--========================================================
-- PATHFINDING
--========================================================

local function CalculatePath(target)

    if not target then
        return {}
    end

    UpdateRayFilter()

    local start

    if Root then
        start = Root.Position
    else
        return {}
    end

    local path =
        PathfindingService:CreatePath({
            AgentRadius =
                CONFIG.AgentRadius,

            AgentHeight =
                CONFIG.AgentHeight,

            AgentCanJump = true,

            AgentCanClimb = true,

            WaypointSpacing =
                CONFIG.WaypointSpacing,
        })

    local success =
        pcall(function()

            path:ComputeAsync(
                start,
                target
            )

        end)

    if not success then
        return {}
    end

    if path.Status ~=
        Enum.PathStatus.Success then

        return {}
    end

    local points = {}

    for _,waypoint in ipairs(
        path:GetWaypoints()
    ) do

        if #points >=
            CONFIG.MaxVisualSegments then

            break

        end

        table.insert(
            points,
            {
                Position =
                    waypoint.Position,

                Action =
                    waypoint.Action,
            }
        )

    end

    return points

end

--========================================================
-- DRAW PATH
--========================================================

local function DrawPath()

    HideRays()

    if not Enabled then
        return
    end

    if not Root then
        return
    end

    local previous =
        Root.Position

    for i,point in ipairs(
        CurrentPath
    ) do

        local position =
            point.Position

        -- Tự bẻ góc theo waypoint
        DrawRay(
            i,
            previous,
            position
        )

        previous = position

    end

    -- Đoạn cuối tới target
    if TargetPosition
    and previous then

        DrawRay(
            #CurrentPath + 1,
            previous,
            TargetPosition
        )

    end

end

--========================================================
-- SET TARGET
--========================================================

local function SetTarget(
    position,
    normal
)

    if not Enabled then
        return
    end

    TargetPosition =
        position

    TargetNormal =
        normal

    CreateMarker(
        position,
        normal
    )

    ClearPath()

    PathVersion += 1

    local version =
        PathVersion

    task.delay(
        CONFIG.RecalculateDelay,
        function()

            if not Enabled then
                return
            end

            if version ~=
                PathVersion then

                return
            end

            CurrentPath =
                CalculatePath(
                    TargetPosition
                )

            DrawPath()

        end
    )

end

--========================================================
-- SCREEN RAY
--========================================================

local function GetMapPosition(screenPosition)

    if not Camera then
        return nil
    end

    UpdateRayFilter()

    local cameraRay =
        Camera:ViewportPointToRay(
            screenPosition.X,
            screenPosition.Y
        )

    local result =
        workspace:Raycast(
            cameraRay.Origin,
            cameraRay.Direction *
                CONFIG.MaxDistance,
            RayParams
        )

    if not result then
        return nil
    end

    return
        result.Position,
        result.Normal,
        result.Instance

end

--========================================================
-- UI DETECTION
--========================================================

local function IsInsideUI(position)

    local objects =
        PlayerGui:GetGuiObjectsAtPosition(
            position.X,
            position.Y
        )

    for _,object in ipairs(objects) do

        if object:IsDescendantOf(Main) then
            return true
        end

    end

    return false

end

--========================================================
-- CLICK TARGET INPUT
--========================================================

UserInputService.InputBegan:Connect(
    function(input,processed)

        if processed then
            return
        end

        if not Enabled then
            return
        end

        if not ClickMode then
            return
        end

        local inputType =
            input.UserInputType

        if inputType ~=
            Enum.UserInputType.MouseButton1
        and inputType ~=
            Enum.UserInputType.Touch then

            return
        end

        local position =
            input.Position

        if IsInsideUI(position) then
            return
        end

        local target,
            normal =
            GetMapPosition(
                position
            )

        if not target then
            return
        end

        SetTarget(
            target,
            normal
        )

        -- Click 1 lần -> chọn target
        ClickMode = false

        ClickButton.Text =
            "CLICK : SELECT"

        ClickButton.TextColor3 =
            Color3.fromRGB(
                100,
                180,
                255
            )

    end
)

