local function AddToggleButton(text, stateKey, order, callback)
    local item = InstNew("TextButton", {
        Name = "Toggle_" .. stateKey,
        LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = GLASS,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 4
    }, scroll)

    Round(item, 8)
    local stroke = Stroke(item, CYAN, 1.1, 0.35)

    local label = InstNew("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -24, 1, 0),
        BackgroundTransparency = 1,
        Text = text .. ": TẮT",
        TextColor3 = ICE,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5
    }, item)

    Connect(item.Activated, function()
        if closed then return end
        states[stateKey] = not states[stateKey]
        local active = states[stateKey]
        label.Text = text .. ": " .. (active and "BẬT" or "TẮT")
        item.BackgroundColor3 = active and Col3RGB(10, 50, 90) or GLASS
        stroke.Color = active and GREEN or CYAN
        status.Text = "●  " .. text .. " : " .. (active and "BẬT" or "TẮT")
        
        if callback then
            pcall(function() callback(active) end)
        end
    end)

    return item
end

