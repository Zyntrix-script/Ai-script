local function refreshAllESP()
    -- Xóa toàn bộ ESP cũ trước khi quét lại
    if espContainer then
        espContainer:ClearAllChildren()
    end
    table.clear(activeESPElements)

    if BotFolder and (states.espPlayer or states.espNextbot) then
        for _, child in ipairs(BotFolder:GetChildren()) do
            applyEntityESP(child)
        end
    end
    if TicketsFolder and states.espTickets then
        for _, child in ipairs(TicketsFolder:GetChildren()) do
            applyTicketESP(child)
        end
    end
end

