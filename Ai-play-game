local speed = -8
local jumpInterval = 0.1

--==============================================================
-- AUTO JUMP LOGIC
--==============================================================

local function setupAutoJump(character)
    local humanoid = character:WaitForChild("Humanoid")
    
    task.spawn(function()
        while character.Parent and autoJumpEnabled do
            task.wait(jumpInterval)
            if humanoid and humanoid.Health > 0 and humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

