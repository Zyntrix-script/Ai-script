    else
        toggle.Text = "SLIDE OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(25,30,45)
        toggle.TextColor3 = Color3.fromRGB(170,180,200)
        toggleStroke.Color = Color3.fromRGB(70,90,120)

