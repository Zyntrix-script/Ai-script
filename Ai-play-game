	SEARCHING = "SEARCHING",
	CHASING = "CHASING",
	ATTACKING = "ATTACKING",
	REPATHING = "REPATHING",
	RECOVERING = "RECOVERING",
	LOST_TARGET = "LOST_TARGET",
	WAITING = "WAITING"
}

