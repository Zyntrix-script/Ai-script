--==============================================================
-- VARIABLES & LOGIC
--==============================================================

local speedEnabled = false
local autoJumpEnabled = false
local InfiniteSlideEnabled = false
local slideMenuOpened = false

local speed = -8
local jumpInterval = 0.1

-- Character Handler
local CurrentCharacter = nil
local RootPart = nil
local Humanoid = nil

local function SetupCharacter(char)
    CurrentCharacter = char
    RootPart = char:WaitForChild("HumanoidRootPart", 5)
    Humanoid = char:WaitForChild("Humanoid", 5)
end

if LP.Character then
    SetupCharacter(LP.Character)
end

LP.CharacterAdded:Connect(function(char)
    SetupCharacter(char)
    task.wait(0.5)
    if autoJumpEnabled then
        setupAutoJump(char)
    end
end)

-- Auto Jump Logic
local function setupAutoJump(character)
    local hum = character:WaitForChild("Humanoid", 5)
    task.spawn(function()
        while character.Parent and autoJumpEnabled do
            task.wait(jumpInterval)
            if hum and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

