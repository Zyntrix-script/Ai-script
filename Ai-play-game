--==============================================================
-- AI MAIN LOOP
--==============================================================

task.spawn(
    function()

        while true do

            task.wait(0.08)

            if not CONFIG.Enabled then
                continue
            end

            UpdateCharacter()

            if not Character
            or not Humanoid
            or not Root then

                SetState(
                    "RECOVERING",
                    "CHARACTER WAIT"
                )

                continue
            end

            if Humanoid.Health <= 0 then
                continue
            end

            --==================================================
            -- TARGET
            --==================================================

            if not Target then

                SetState(
                    "SCANNING",
                    "WAITING TARGET"
                )

                continue

            end

            --==================================================
            -- ARRIVAL
            --==================================================

            if CheckArrival() then

                task.wait(0.35)

                -- Sau khi tới target,
                -- không tự chọn target mới.
                -- Chờ click target tiếp theo.

                continue
            end

            --==================================================
            -- FALL
            --==================================================

            FallRecovery()

            --==================================================
            -- STUCK
            --==================================================

            if CheckStuck() then

                RecoverFromStuck()

                continue
            end

            --==================================================
            -- RECALCULATE
            --==================================================

            if #Waypoints == 0 then

                Recalculate()

                continue

            end

            if os.clock() -
                LastRecalculate >
                CONFIG.RecalculateTime then

                local scan =
                    ScanEnvironment()

                if scan.KillPart
                or scan.Gap then

                    Recalculate()

                    continue

                end

            end

            --==================================================
            -- WAYPOINT
            --==================================================

            local waypoint =
                Waypoints[
                    CurrentWaypoint
                ]

            if not waypoint then

                Recalculate()

                continue

            end

            SetState(
                "WALKING",
                "WALKING"
            )

            DrawRoute()
            DrawTargetVisual()

            local distance =
                (
                    Root.Position -
                    waypoint.Position
                ).Magnitude

            if distance <=
                CONFIG.WaypointReach then

                CurrentWaypoint += 1

                continue
            end

            --==================================================
            -- MOVING PLATFORM
            --==================================================

            if TargetPart
            and IsMovingPlatform(
                TargetPart
            ) then

                Target =
                    TargetPart.Position +
                    (
                        Target -
                        TargetPart.Position
                    )

            end

            --==================================================
            -- SMART MOVEMENT
            --==================================================

            WalkWaypoint(
                waypoint
            )

        end

    end
)

