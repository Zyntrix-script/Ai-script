local lastWaypointPosition = Vector3.new()
local currentWaypointIndex = 1
local waypoints = {}
local lastRepathTick = 0
local lastStuckCheckTick = time()
local lastPositionForStuck = Vector3.new()
local lastAttackTick = 0

local targetCharacter = nil
local targetHumanoid = nil
local targetRootPart = nil

