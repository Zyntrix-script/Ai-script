--==============================================================
-- MAP SCANNER
--==============================================================

local function ScanEnvironment()

    if not Root then
        return {}
    end

    local origin = Root.Position
    local radius = CONFIG.ScanRadius

    local result = {
        Ground = nil,
        Forward = nil,
        Left = nil,
        Right = nil,
        Up = nil,
        Down = nil,

        DiagonalLeft = nil,
        DiagonalRight = nil,

        Wall = false,
        Edge = false,
        Gap = false,
        Ceiling = false,
        Slope = false,
        Stair = false,
        Obstacle = false,
        Player = false,
        NPC = false,
        KillPart = false,
    }

    result.Forward =
        Cast(
            origin + Vector3.new(0, 2, 0),
            Root.CFrame.LookVector * radius
        )

    result.Left =
        Cast(
            origin + Vector3.new(0, 2, 0),
            -Root.CFrame.RightVector * 12
        )

    result.Right =
        Cast(
            origin + Vector3.new(0, 2, 0),
            Root.CFrame.RightVector * 12
        )

    result.Up =
        Cast(
            origin,
            Vector3.new(0, 15, 0)
        )

    result.Down =
        Cast(
            origin,
            Vector3.new(0, -25, 0)
        )

    result.DiagonalLeft =
        Cast(
            origin + Vector3.new(0, 2, 0),
            (
                Root.CFrame.LookVector -
                Root.CFrame.RightVector * 0.65
            ).Unit * 15
        )

    result.DiagonalRight =
        Cast(
            origin + Vector3.new(0, 2, 0),
            (
                Root.CFrame.LookVector +
                Root.CFrame.RightVector * 0.65
            ).Unit * 15
        )

    result.Ground =
        Cast(
            origin + Vector3.new(0, 1, 0),
            Vector3.new(0, -8, 0)
        )

    if result.Forward then

        result.Wall =
            math.abs(
                result.Forward.Normal.Y
            ) < 0.35

        result.Obstacle = true

        local hit = result.Forward.Instance

        if hit then

            if CollectionService:HasTag(
                hit,
                "KillPart"
            ) then

                result.KillPart = true

            end

            local n = hit.Name:lower()

            if n:find("lava")
            or n:find("kill")
            or n:find("void")
            or n:find("death") then

                result.KillPart = true

            end

        end

    end

    if result.Up then
        result.Ceiling = true
    end

    if not result.Down then
        result.Gap = true
    end

    if result.Ground then

        local normalY =
            result.Ground.Normal.Y

        if normalY < 0.75
        and normalY > 0.25 then

            result.Slope = true

        end

        if normalY > 0.92 then
            result.Stair = true
        end

    end

    local function CheckPlayer(hit)

        if not hit then
            return false
        end

        local model =
            hit.Instance:FindFirstAncestorOfClass(
                "Model"
            )

        if not model then
            return false
        end

        if Players:GetPlayerFromCharacter(
            model
        ) then

            return true

        end

        if model:FindFirstChildOfClass(
            "Humanoid"
        ) then

            return true

        end

        return false

    end

    result.Player =
        CheckPlayer(result.Forward)

    result.NPC =
        CheckPlayer(result.Forward)

    if result.Gap then
        result.Edge = true
    end

    return result
end

--==============================================================
-- SAFE POSITION CHECK
--==============================================================

local function IsSafePosition(position)

    local ground =
        Cast(
            position + Vector3.new(0, 3, 0),
            Vector3.new(0, -12, 0)
        )

    if not ground then
        return false
    end

    if ground.Normal.Y < 0.45 then
        return false
    end

    local hit =
        ground.Instance

    if hit then

        local name =
            hit.Name:lower()

        if name:find("lava")
        or name:find("kill")
        or name:find("death")
        or name:find("void") then

            return false

        end

    end

    return true
end

--==============================================================
-- LINE OF SIGHT
--==============================================================

local function HasLineOfSight(a, b)

    local hit =
        Cast(
            a,
            b - a
        )

    return hit == nil
end

--==============================================================
-- PATH MEMORY
--==============================================================

local function MemoryKey(a, b)

    return
        math.floor(a.X / 8)
        .. ":"
        .. math.floor(a.Z / 8)
        .. ">"
        .. math.floor(b.X / 8)
        .. ":"
        .. math.floor(b.Z / 8)

end

local function RememberRoute(route)

    if not route or #route == 0 then
        return
    end

    local first = route[1]
    local last = route[#route]

    local key =
        MemoryKey(
            first,
            last
        )

    RouteMemory[key] = {
        route = route,
        score = 1,
        time = os.clock()
    }

    local count = 0

    for _ in pairs(RouteMemory) do
        count += 1
    end

    if count > 40 then

        local oldestKey
        local oldestTime = math.huge

        for k, data in pairs(RouteMemory) do

            if data.time < oldestTime then
                oldestTime = data.time
                oldestKey = k
            end

        end

        if oldestKey then
            RouteMemory[oldestKey] = nil
        end

    end
end

--==============================================================
-- PATHFINDING
--==============================================================

local function BuildPath(target)

    if not Root or not target then
        return {}
    end

    SetState(
        "CALCULATING",
        "BUILDING ROUTE"
    )

    local path =
        PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,

            WaypointSpacing = 4,

            Costs = {
                Water = 5,
                Danger = 1000,
            }
        })

    local ok =
        pcall(
            function()

                path:ComputeAsync(
                    Root.Position,
                    target
                )

            end
        )

    if ok
    and path.Status ==
        Enum.PathStatus.Success then

        local points = {}

        for _, wp in ipairs(
            path:GetWaypoints()
        ) do

            if #points >=
                CONFIG.MaxWaypoints then
                break
            end

            local position =
                wp.Position

            local safe =
                IsSafePosition(
                    position
                )

            table.insert(
                points,
                {
                    Position = position,
                    Action = wp.Action,
                    Safe = safe,
                }
            )

        end

        if #points > 0 then
            return points
        end

    end

    --==========================================================
    -- FALLBACK SMART NODES
    --==========================================================

    local nodes = {}

    local origin =
        Root.Position

    local directions = {
        Vector3.new(0, 0, -1),
        Vector3.new(1, 0, -1).Unit,
        Vector3.new(-1, 0, -1).Unit,
        Vector3.new(1, 0, 0),
        Vector3.new(-1, 0, 0),
        Vector3.new(1, 0, 1).Unit,
        Vector3.new(-1, 0, 1).Unit,
        Vector3.new(0, 0, 1),
    }

    local distance =
        math.clamp(
            (target - origin).Magnitude / 4,
            4,
            16
        )

    for _, dir in ipairs(
        directions
    ) do

        local p =
            origin +
            dir * distance

        local ray =
            Cast(
                p + Vector3.new(0, 8, 0),
                Vector3.new(0, -18, 0)
            )

        if ray
        and ray.Normal.Y > 0.45 then

            local node =
                ray.Position +
                Vector3.new(0, 2.5, 0)

            local safe =
                IsSafePosition(node)

            table.insert(
                nodes,
                {
                    Position = node,
                    Action =
                        Enum.PathWaypointAction.Walk,
                    Safe = safe,
                }
            )

        end

    end

    table.sort(
        nodes,
        function(a, b)

            local da =
                (a.Position - target).Magnitude

            local db =
                (b.Position - target).Magnitude

            local sa =
                a.Safe and 0 or 100

            local sb =
                b.Safe and 0 or 100

            return da + sa <
                db + sb

        end
    )

    if #nodes > 0 then

        table.insert(
            nodes,
            {
                Position = target,
                Action =
                    Enum.PathWaypointAction.Walk,
                Safe = true,
            }
        )

    end

    return nodes
end

--==============================================================
-- JUMP PREDICTION
--==============================================================

local function PredictLanding(target)

    if not Root then
        return nil
    end

    local velocity =
        Root.AssemblyLinearVelocity

    local horizontal =
        Vector3.new(
            velocity.X,
            0,
            velocity.Z
        )

    local delta =
        target - Root.Position

    local horizontalDistance =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        ).Magnitude

    local gravity =
        workspace.Gravity

    local jumpPower =
        Humanoid
        and Humanoid.JumpPower
        or 50

    local airtime =
        math.clamp(
            horizontalDistance /
            math.max(
                horizontal.Magnitude,
                18
            ),
            0.25,
            1.5
        )

    local vertical =
        jumpPower * airtime -
        0.5 * gravity *
        airtime *
        airtime

    return
        Root.Position +
        horizontal * airtime +
        Vector3.new(
            0,
            vertical,
            0
        )
end

--==============================================================
-- JUMP CONFIDENCE
--==============================================================

local function GetJumpConfidence(target)

    if not Root or not target then
        return 0
    end

    local delta =
        target - Root.Position

    local horizontal =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        ).Magnitude

    local vertical =
        math.abs(delta.Y)

    local score = 100

    if horizontal >
        CONFIG.MaxJumpDistance then

        score -= 60

    end

    if vertical >
        CONFIG.JumpHeightCheck then

        score -= 30

    end

    local landing =
        PredictLanding(target)

    if landing then

        local safe =
            IsSafePosition(
                landing
            )

        if not safe then
            score -= 50
        end

    else

        score -= 30

    end

    return math.clamp(
        score,
        0,
        100
    )
end

--==============================================================
-- SMART JUMP
--==============================================================

local function SmartJump(target)

    if not Humanoid or
        not Root or
        not target then

        return false

    end

    if os.clock() - LastJump <
        CONFIG.JumpCooldown then

        return false

    end

    local confidence =
        GetJumpConfidence(
            target
        )

    local required = 55

    if CONFIG.Mode == "SAFE" then
        required = 75
    elseif CONFIG.Mode == "PRO" then
        required = 45
    end

    if confidence < required then
        return false
    end

    SetState(
        "PREPARING_JUMP",
        "JUMP CONFIDENCE "
        .. math.floor(confidence)
    )

    task.wait(
        CONFIG.ReactionDelay
    )

    if not CONFIG.Enabled then
        return false
    end

    local landing =
        PredictLanding(target)

    if landing then

        DrawRay(
            5,
            Root.Position,
            landing,
            Color3.fromRGB(
                57,
                255,
                20
            ),
            0.18
        )

    end

    LastJump = os.clock()

    Humanoid.Jump = true

    SetState(
        "JUMPING",
        "SMART JUMP"
    )

    return true
end

--==============================================================
-- OBSTACLE AVOIDANCE
--==============================================================

local function AvoidObstacle(scan)

    if not Root or not Humanoid then
        return false
    end

    if not scan.Obstacle
    and not scan.Player
    and not scan.NPC then

        return false

    end

    SetState(
        "AVOIDING",
        "OBSTACLE AVOIDANCE"
    )

    local left =
        Cast(
            Root.Position +
                Vector3.new(0, 2, 0),
            -Root.CFrame.RightVector * 8
        )

    local right =
        Cast(
            Root.Position +
                Vector3.new(0, 2, 0),
            Root.CFrame.RightVector * 8
        )

    local leftSafe =
        not left

    local rightSafe =
        not right

    if leftSafe
    and not rightSafe then

        Humanoid:Move(
            -Root.CFrame.RightVector,
            false
        )

    elseif rightSafe
    and not leftSafe then

        Humanoid:Move(
            Root.CFrame.RightVector,
            false
        )

    elseif leftSafe
    and rightSafe then

        local target =
            Target

        if target then

            local lp =
                (
                    Root.Position -
                    Root.CFrame.RightVector * 5 -
                    target
                ).Magnitude

            local rp =
                (
                    Root.Position +
                    Root.CFrame.RightVector * 5 -
                    target
                ).Magnitude

            if lp < rp then

                Humanoid:Move(
                    -Root.CFrame.RightVector,
                    false
                )

            else

                Humanoid:Move(
                    Root.CFrame.RightVector,
                    false
                )

            end

        end

    else

        Humanoid:Move(
            -Root.CFrame.LookVector,
            false
        )

    end

    task.wait(0.12)

    return true
end

--==============================================================
-- SPEED CONTROL
--==============================================================

local function GetCurrentSpeed()

    local speed = CONFIG.Speed

    if CONFIG.Mode == "SAFE" then
        speed = math.min(speed, 80)
    elseif CONFIG.Mode == "NORMAL" then
        speed = math.min(speed, 220)
    elseif CONFIG.Mode == "PRO" then
        speed = math.min(speed, 500)
    end

    return math.clamp(
        speed,
        1,
        CONFIG.MaxSpeed
    )
end

--==============================================================
-- HUMAN-LIKE SPEED
--==============================================================

local function CalculateMovementSpeed(scan)

    local speed =
        GetCurrentSpeed()

    if scan.Edge
    or scan.Gap then

        speed *= 0.35

    elseif scan.Obstacle
    or scan.Player
    or scan.NPC then

        speed *= 0.55

    elseif Target and Root then

        local d =
            (Target - Root.Position).Magnitude

        if d < 20 then
            speed *= 0.55
        elseif d < 8 then
            speed *= 0.35
        end

    end

    return math.max(
        speed,
        8
    )
end

--==============================================================
-- MOVING PLATFORM DETECTION
--==============================================================

local function IsMovingPlatform(part)

    if not part
    or not part:IsA("BasePart") then

        return false
    end

    return
        part.AssemblyLinearVelocity.Magnitude >
        1
end

--==============================================================
-- PLATFORM WIDTH
--==============================================================

local function PlatformWidth(part)

    if not part
    or not part:IsA("BasePart") then

        return 0
    end

    return math.max(
        part.Size.X,
        part.Size.Z
    )
end

--==============================================================
-- WALK WAYPOINT
--==============================================================

local function WalkWaypoint(data)

    if not data
    or not Root
    or not Humanoid then

        return false
    end

    local target =
        data.Position

    local distance =
        (Root.Position - target).Magnitude

    if distance <=
        CONFIG.WaypointReach then

        return true
    end

    local scan =
        ScanEnvironment()

    --==========================================================
    -- DANGER
    --==========================================================

    if scan.KillPart then

        SetState(
            "RECALCULATING",
            "DANGER DETECTED"
        )

        return false
    end

    --==========================================================
    -- OBSTACLE
    --==========================================================

    if AvoidObstacle(scan) then
        return true
    end

    --==========================================================
    -- GAP / JUMP
    --==========================================================

    if scan.Gap
    or data.Action ==
        Enum.PathWaypointAction.Jump then

        SmartJump(
            target
        )

    end

    --==========================================================
    -- CLIMB / PARKOUR
    --==========================================================

    if data.Action ==
        Enum.PathWaypointAction.Jump then

        SmartJump(
            target
        )

    end

    --==========================================================
    -- SPEED
    --==========================================================

    Humanoid.WalkSpeed =
        CalculateMovementSpeed(
            scan
        )

    --==========================================================
    -- SMOOTH DIRECTION
    --==========================================================

    local direction =
        target -
        Root.Position

    if direction.Magnitude > 0.1 then

        local unit =
            direction.Unit

        Humanoid:Move(
            unit,
            false
        )

    end

    Humanoid:MoveTo(
        target
    )

    return true
end

--==============================================================
-- ROUTE VISUAL
--==============================================================

local function DrawRoute()

    for i = 1, CONFIG.MaxRouteVisuals do

        local data =
            Waypoints[i]

        if data then

            DrawNode(
                i,
                data.Position,
                not data.Safe
            )

            local previous

            if i == 1 then
                previous =
                    Root
                    and Root.Position
            else
                previous =
                    Waypoints[i - 1]
                    and Waypoints[i - 1].Position
            end

            if previous then

                local color

                if data.Safe then
                    color =
                        Color3.fromRGB(
                            57,
                            255,
                            20
                        )
                else
                    color =
                        Color3.fromRGB(
                            255,
                            60,
                            60
                        )
                end

                DrawRay(
                    i + 10,
                    previous,
                    data.Position,
                    color,
                    0.22
                )

            end

        else

            DrawNode(
                i,
                Vector3.zero,
                false
            )

            local node =
                NodePool[i]

            if node then
                node.Transparency = 1
            end

            local ray =
                RayPool[i + 10]

            if ray then
                ray.Transparency = 1
            end

        end

    end

end

--==============================================================
-- TARGET RAYS
--==============================================================

local function DrawTargetVisual()

    if not Root or not Target then
        return
    end

    DrawRay(
        1,
        Root.Position,
        Target,
        Color3.fromRGB(
            57,
            255,
            20
        ),
        0.15
    )

    if Waypoints[CurrentWaypoint] then

        DrawRay(
            2,
            Root.Position,
            Waypoints[
                CurrentWaypoint
            ].Position,
            Color3.fromRGB(
                57,
                255,
                20
            ),
            0.20
        )

    end

end

--==============================================================
-- ARRIVAL
--==============================================================

local function CheckArrival()

    if not Root or not Target then
        return false
    end

    local distance =
        (Root.Position - Target).Magnitude

    if distance <=
        CONFIG.ArrivalThreshold then

        SetState(
            "ARRIVED",
            "TARGET REACHED"
        )

        if Humanoid then

            Humanoid:Move(
                Vector3.zero,
                false
            )

            Humanoid:MoveTo(
                Root.Position
            )

        end

        RemoveMarker()

        Waypoints = {}
        CurrentWaypoint = 1

        return true
    end

    return false
end

--==============================================================
-- STUCK DETECTION
--==============================================================

local function CheckStuck()

    if not Root then
        return false
    end

    local position =
        Root.Position

    if not LastPosition then

        LastPosition =
            position

        LastMoveTime =
            os.clock()

        return false
    end

    local moved =
        (
            position -
            LastPosition
        ).Magnitude

    if moved > 0.6 then

        LastPosition =
            position

        LastMoveTime =
            os.clock()

        return false

    end

    if os.clock() -
        LastMoveTime >
        CONFIG.StuckTime then

        return true
    end

    return false
end

--==============================================================
-- STUCK RECOVERY
--==============================================================

local function RecoverFromStuck()

    SetState(
        "RECOVERING",
        "STUCK RECOVERY"
    )

    if not Humanoid or not Root then
        return
    end

    -- Level 1: đổi hướng
    local right =
        Root.CFrame.RightVector

    Humanoid:Move(
        right,
        false
    )

    task.wait(0.18)

    if not CheckStuck() then
        return
    end

    -- Level 2: lùi
    Humanoid:Move(
        -Root.CFrame.LookVector,
        false
    )

    task.wait(0.25)

    if not CheckStuck() then
        return
    end

    -- Level 3: jump nếu an toàn
    local scan =
        ScanEnvironment()

    if not scan.Gap
    and not scan.KillPart then

        SmartJump(
            Root.Position +
            Root.CFrame.LookVector * 5
        )

        task.wait(0.25)

    end

    -- Level 4: recalculate
    if Target then

        SetState(
            "RECALCULATING",
            "ROUTE RECALCULATE"
        )

        Waypoints =
            BuildPath(
                Target
            )

        CurrentWaypoint = 1

        LastRecalculate =
            os.clock()

    end

end

--==============================================================
-- FALL RECOVERY
--==============================================================

local function FallRecovery()

    if not Root then
        return
    end

    local velocity =
        Root.AssemblyLinearVelocity

    if velocity.Y < -55 then

        SetState(
            "RECOVERING",
            "FALL RECOVERY"
        )

        local below =
            Cast(
                Root.Position,
                Vector3.new(
                    0,
                    -40,
                    0
                )
            )

        if below
        and IsSafePosition(
            below.Position
        ) then

            DrawRay(
                4,
                Root.Position,
                below.Position,
                Color3.fromRGB(
                    57,
                    255,
                    20
                ),
                0.15
            )

        end

    end
end

--==============================================================
-- ROUTE RECALCULATE
--==============================================================

local function Recalculate()

    if not Target or not Root then
        return false
    end

    SetState(
        "RECALCULATING",
        "NEW ROUTE"
    )

    Waypoints =
        BuildPath(
            Target
        )

    CurrentWaypoint = 1

    LastRecalculate =
        os.clock()

    DrawRoute()

    return #Waypoints > 0
end

--==============================================================
-- SET TARGET
--==============================================================

local function SetTarget(position, normal, hitPart)

    if not CONFIG.Enabled then
        return
    end

    RunningToken += 1

    Target =
        position

    TargetNormal =
        normal

    TargetPart =
        hitPart

    CreateMarker(
        position,
        normal
    )

    Waypoints = {}
    CurrentWaypoint = 1

    SetState(
        "TARGET_SELECTED",
        "TARGET SELECTED"
    )

    task.spawn(
        function()

            local token =
                RunningToken

            task.wait(
                CONFIG.ReactionDelay
            )

            if token ~= RunningToken
            or not CONFIG.Enabled then

                return
            end

            Recalculate()

        end
    )
end

--==============================================================
-- CLEAR TARGET
--==============================================================

local function ClearTarget()

    RunningToken += 1

    Target = nil
    TargetNormal = nil
    TargetPart = nil

    Waypoints = {}
    CurrentWaypoint = 1

    RemoveMarker()
    HideRays()

    SetState(
        "IDLE",
        "IDLE"
    )

end

--==============================================================
-- CAMERA CLICK / TOUCH
--==============================================================

local function IsOverUI(position)

    local objects =
        Player.PlayerGui:GetGuiObjectsAtPosition(
            position.X,
            position.Y
        )

    for _, obj in ipairs(objects) do

        if obj:IsDescendantOf(Main) then
            return true
        end

    end

    return false
end

local function GetTargetFromScreen(position)

    local ray =
        Camera:ViewportPointToRay(
            position.X,
            position.Y
        )

    UpdateRayFilter()

    local hit =
        workspace:Raycast(
            ray.Origin,
            ray.Direction *
                2000,
            RayParams
        )

    if not hit then
        return nil
    end

    local point =
        hit.Position

    local normal =
        hit.Normal

    local part =
        hit.Instance

    if not IsSafePosition(
        point
    ) then

        return nil

    end

    return point, normal, part
end

