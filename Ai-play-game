task.spawn(function()
    while not closed do
        task.wait(0.4)
        if states.autoFarmTickets and TicketsFolder then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, ticket in ipairs(TicketsFolder:GetChildren()) do
                    if closed or not states.autoFarmTickets then break end
                    local tPart = ticket
                    if ticket:IsA("Model") then
                        tPart = ticket.PrimaryPart or ticket:FindFirstChildWhichIsA("BasePart")
                    end
                    if tPart and tPart:IsA("BasePart") then
                        pcall(function()
                            char:PivotTo(tPart.CFrame + Vector3.new(0, 3, 0))
                        end)
                        task.wait(0.25)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while not closed do
        task.wait(0.15)
        if states.avoidNextbot and BotFolder then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, bot in ipairs(BotFolder:GetChildren()) do
                    if bot:GetAttribute("Team") == "Nextbot" or string.find(bot.Name:lower(), "nextbot") then
                        local botRoot = bot:FindFirstChild("HumanoidRootPart") or bot:FindFirstChildWhichIsA("BasePart")
                        if botRoot then
                            local offset = root.Position - botRoot.Position
                            local distance = offset.Magnitude
                            if distance > 0 and distance < 28 then
                                pcall(function()
                                    char:PivotTo(
                                        root.CFrame  
                                        + offset.Unit * 18  
                                        + Vector3.new(0, 4, 0)  
                                    )
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

