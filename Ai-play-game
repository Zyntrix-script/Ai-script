-- Speed Loop
Connect(RunService.RenderStepped, function()
    if closed or not states.speedBoost then return end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.MoveDirection.Magnitude > 0 then
            hrp.Velocity = Vector3.new(
                hum.MoveDirection.X * speedValue * 10,
                hrp.Velocity.Y,
                hum.MoveDirection.Z * speedValue * 10
            )
        end
    end
end)

-- Auto Jump Loop
task.spawn(function()
    while not closed do
        task.wait(jumpInterval)
        if states.autoJump then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

-- Infinite Slide & Slide Speed
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

Connect(RunService.RenderStepped, function()
    if closed or not states.infiniteSlide or not CurrentCharacter or not RootPart or not Humanoid or Humanoid.Health <= 0 then
        return
    end

    pcall(function()  
        local currentVel = RootPart.AssemblyLinearVelocity  
        local horizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)  

        if horizontalVel.Magnitude > 5 then  
            local currentCFrame = RootPart.CFrame  
            raycastParams.FilterDescendantsInstances = {CurrentCharacter}  
            local raycastResult = Workspace:Raycast(currentCFrame.Position, Vector3.new(0, -4, 0), raycastParams)  

            if raycastResult then  
                local targetY = raycastResult.Position.Y + 3 + 0.001  
                RootPart.CFrame = CFrame.new(currentCFrame.X, targetY, currentCFrame.Z) * currentCFrame.Rotation  
            end  
            RootPart.AssemblyLinearVelocity = Vector3.new(
                horizontalVel.X * states.slideSpeed, 
                currentVel.Y, 
                horizontalVel.Z * states.slideSpeed
            )  
        end  
    end)
end)

