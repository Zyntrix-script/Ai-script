local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Tọa độ cố định bạn đã cung cấp
local carryFixedPos = UDim2.new(0.699999988, 169, 0.400000006, 7)
local healFixedPos = UDim2.new(0.300000012, 359, 0.400000006, 6)
local uncarryFixedPos = UDim2.new(0.5, 224, 0.670000017, -109)

-- Hàm tìm kiếm đường dẫn UI an toàn
local function getIcons()
	local pGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not pGui then return nil, nil, nil end
	local gameFolder = pGui:FindFirstChild("Game")
	if not gameFolder then return nil, nil, nil end
	local hud = gameFolder:FindFirstChild("HUD")
	if not hud then return nil, nil, nil end
	local mobile = hud:FindFirstChild("Mobile")
	if not mobile then return nil, nil, nil end
	local center = mobile:FindFirstChild("Center")
	if not center then return nil, nil, nil end
	local interact1 = center:FindFirstChild("Interact")
	if not interact1 then return nil, nil, nil end
	local interact2 = interact1:FindFirstChild("Interact")
	if not interact2 then return nil, nil, nil end
	
	return interact2:FindFirstChild("CarryIcon"), interact2:FindFirstChild("HealIcon"), interact2:FindFirstChild("UncarryIcon")
end

-- Vòng lặp tự động khóa và ép chặt tọa độ ngay khi bật script, chống mất khi chết/hồi sinh
RunService.RenderStepped:Connect(function()
	pcall(function()
		local carryIcon, healIcon, uncarryIcon = getIcons()
		
		if carryIcon then
			carryIcon.Visible = true
			carryIcon.Active = true
			carryIcon.Position = carryFixedPos
		end
		
		if healIcon then
			healIcon.Visible = true
			healIcon.Active = true
			healIcon.Position = healFixedPos
		end
		
		if uncarryIcon then
			uncarryIcon.Visible = true
			uncarryIcon.Active = true
			uncarryIcon.Position = uncarryFixedPos
		end
	end)
end)

