--==============================================================
-- MAIN LOOP
--==============================================================

RunService.RenderStepped:Connect(function()

    local char = LP.Character
    if not char then
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not hrp or not hum then
        return
    end

    --==========================================================
    -- SLIDE
    --==========================================================

    if slideEnabled and hum.MoveDirection.Magnitude > 0 then

        hrp.Velocity = Vector3.new(
            hum.MoveDirection.X * speed * 10,
            hrp.Velocity.Y,
            hum.MoveDirection.Z * speed * 10
        )

    end

    --==========================================================
    -- AUTO JUMP
    --==========================================================

    if autoJumpEnabled
        and hum.MoveDirection.Magnitude > 0
        and tick() - lastJump >= jumpCooldown then

        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        lastJump = tick()

    end

end)

--==============================================================
-- RESPAWN SUPPORT
--==============================================================

LP.CharacterAdded:Connect(function()

    task.wait(0.25)

    if slideEnabled and autoJumpEnabled then
        status.Text = "● SLIDE + JUMP"
    elseif slideEnabled then
        status.Text = "● SLIDE ACTIVE"
    elseif autoJumpEnabled then
        status.Text = "● JUMP ACTIVE"
    else
        status.Text = "● READY"
    end

end)
