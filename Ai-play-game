local function createToggleButton(text, posY, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 28)
	btn.Position = UDim2.new(0.05, 0, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = text .. ": OFF"
	btn.TextSize = 12
	btn.Font = Enum.Font.SourceSansBold
	btn.Parent = mainPanel
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 4)
	btnCorner.Parent = btn
	
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(40, 40, 40)
		btn.Text = text .. (state and ": ON" or ": OFF")
		callback(state)
	end)
	return btn
end

createToggleButton("AI TOGGLE", 145, function(state)
	isAIActive = state
	if not isAIActive and npcHumanoid then
		npcHumanoid:MoveTo(npcRootPart.Position)
		currentAIState = State.IDLE
	end
end)

createToggleButton("SPAWN NPC", 180, function(state)
	if state then
		spawnNPC()
	else
		despawnNPC()
	end
end)

createToggleButton("DEBUG VISUAL", 215, function(state)
	isDebugVisualsOn = state
	debugFolder.Parent = state and Workspace or nil
end)

-- SPAWN & DESPAWN LOGIC FOR NPC
function spawnNPC()
	despawnNPC()
	currentHP = CONFIG.MAX_HEALTH
	
	pcall(function()
		local modelClone = game:GetService("InsertService"):LoadAsset(CONFIG.NPC_ASSET_ID)
		if modelClone then
			npcModel = modelClone:GetChildren()[1] or modelClone
			npcModel.Name = "KillerNPC_" .. math.random(1000,9999)
			npcModel.Parent = Workspace
			
			if not npcModel.PrimaryPart then
				npcModel.PrimaryPart = npcModel:FindFirstChild("HumanoidRootPart") or npcModel:FindFirstChild("Torso")
			end
			
			local spawnPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
				and (LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(10, 0, 10)) or Vector3.new(0, 5, 0)
			
			if npcModel.PrimaryPart then
				npcModel:SetPrimaryPartCFrame(CFrame.new(spawnPos))
			end
			
			npcHumanoid = npcModel:FindFirstChildOfClass("Humanoid")
			npcRootPart = npcModel:FindFirstChild("HumanoidRootPart") or npcModel.PrimaryPart
			
			if npcHumanoid and npcRootPart then
				npcHumanoid.WalkSpeed = CONFIG.WALK_SPEED
				
				-- Track NPC Health (10 hits to kill)
				npcHumanoid.HealthChanged:Connect(function(health)
					if health <= 0 then
						despawnNPC()
					end
				end)
			end
		end
	end)
end

function despawnNPC()
	if npcModel then
		npcModel:Destroy()
		npcModel = nil
		npcHumanoid = nil
		npcRootPart = nil
	end
end

-- TARGET BINDING
local function updateTarget()
	if LocalPlayer.Character then
		targetCharacter = LocalPlayer.Character
		targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		targetRootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
	else
		targetCharacter = nil
		targetHumanoid = nil
		targetRootPart = nil
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	updateTarget()
	if char then
		char:WaitForChild("Humanoid").Died:Connect(function()
			currentAIState = State.WAITING
		end)
	end
end)

if LocalPlayer.Character then
	updateTarget()
	LocalPlayer.Character:WaitForChild("Humanoid").Died:Connect(function()
		currentAIState = State.WAITING
	end)
end

-- ADVANCED PREDICTION & PATHFINDING
local function computePath(destination)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2.5,
		AgentHeight = 5,
		AgentCanJump = true,
		WaypointSpacing = 4,
	})
	
	local success, err = pcall(function()
		path:ComputeAsync(npcRootPart.Position, destination)
	end)
	
	if success and path.Status == Enum.PathStatus.Success then
		waypoints = path:GetWaypoints()
		currentWaypointIndex = 2
		return true
	end
	return false
end

local function getPredictedPosition()
	if not targetRootPart or not targetHumanoid then return Vector3.new() end
	local velocity = targetRootPart.Velocity
	local speed = velocity.Magnitude
	local predictionFactor = math.clamp(speed / 15, 0.5, 2.0)
	return targetRootPart.Position + (velocity * 0.3 * predictionFactor)
end

-- MAIN AI LOOP (RunService Heartbeat)
RunService.Heartbeat:Connect(function(dt)
	updateTarget()
	
	if not isAIActive or not npcModel or not npcHumanoid or not npcRootPart then
		stateDisp.Text = "STATE: INACTIVE"
		distDisp.Text = "DISTANCE: N/A"
		speedDisp.Text = "SPEED: 0"
		hpDisp.Text = "NPCHP: " .. currentHP
		stuckDisp.Text = "STUCK: NO"
		return
	end
	
	if not targetRootPart or not targetHumanoid or targetHumanoid.Health <= 0 then
		currentAIState = State.WAITING
		stateDisp.Text = "STATE: WAITING (RESPAWN)"
		return
	end
	
	local distance = (targetRootPart.Position - npcRootPart.Position).Magnitude
	
	-- UI Updates
	stateDisp.Text = "STATE: " .. currentAIState
	distDisp.Text = string.format("DISTANCE: %.1f studs", distance)
	speedDisp.Text = string.format("SPEED: %.1f", npcRootPart.Velocity.Magnitude)
	hpDisp.Text = "NPCHP: " .. currentHP .. "/" .. CONFIG.MAX_HEALTH
	
	-- STATE MACHINE LOGIC
	if currentAIState == State.WAITING then
		if targetRootPart and targetHumanoid and targetHumanoid.Health > 0 then
			currentAIState = State.CHASING
		end
		return
	end
	
	-- Check Attack Range
	if distance <= CONFIG.ATTACK_RANGE then
		currentAIState = State.ATTACKING
		npcHumanoid:MoveTo(npcRootPart.Position) -- Stop moving
		
		-- Look at target smoothly
		local lookAtPos = Vector3.new(targetRootPart.Position.X, npcRootPart.Position.Y, targetRootPart.Position.Z)
		npcRootPart.CFrame = CFrame.new(npcRootPart.Position, lookAtPos)
		
		if tick() - lastAttackTick >= CONFIG.ATTACK_COOLDOWN then
			lastAttackTick = tick()
			-- Simulate attack on LocalPlayer
			if targetHumanoid then
				targetHumanoid.Health = math.max(0, targetHumanoid.Health - 15)
			end
		end
		return
	end
	
	-- Stuck Detector
	if (npcRootPart.Position - lastPositionForStuck).Magnitude < 1.0 then
		if time() - lastStuckCheckTick > CONFIG.STUCK_TIMEOUT then
			currentAIState = State.RECOVERING
			lastStuckCheckTick = time()
		end
	else
		lastStuckCheckTick = time()
		lastPositionForStuck = npcRootPart.Position
		stuckDisp.Text = "STUCK: NO"
	end
	
	if currentAIState == State.RECOVERING then
		stuckDisp.Text = "STUCK: YES (RECOVERING)"
		npcHumanoid.Jump = true
		npcHumanoid:MoveTo(npcRootPart.Position + Vector3.new(math.random(-8,8), 0, math.random(-8,8)))
		task.wait(0.5)
		currentAIState = State.CHASING
		return
	end
	
	-- Chasing & Repathing Loop
	currentAIState = State.CHASING
	npcHumanoid.WalkSpeed = CONFIG.CHASE_SPEED
	
	if tick() - lastRepathTick >= CONFIG.WAYPOINT_RECALC_INTERVAL then
		lastRepathTick = tick()
		local destination = getPredictedPosition()
		computePath(destination)
	end
	
	if waypoints and #waypoints > 0 then
		if currentWaypointIndex <= #waypoints then
			local waypoint = waypoints[currentWaypointIndex]
			npcHumanoid:MoveTo(waypoint.Position)
			
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				npcHumanoid.Jump = true
			end
			
			if (npcRootPart.Position - waypoint.Position).Magnitude < 4 then
				currentWaypointIndex = currentWaypointIndex + 1
			end
		else
			npcHumanoid:MoveTo(targetRootPart.Position)
		end
	else
		npcHumanoid:MoveTo(targetRootPart.Position)
	end
end)
